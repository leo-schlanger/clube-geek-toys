# PostgreSQL
POSTGRES_USER=clube_geek
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=clube_geek_toys

# JWT
JWT_SECRET=CHANGE_ME_64_char_random_string
JWT_REFRESH_SECRET=CHANGE_ME_different_64_char_random_string
HMAC_SECRET=CHANGE_ME_another_64_char_random_string

# Stripe
STRIPE_SECRET_KEY=sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_... (required in production)

# PIX
PIX_KEY=<chave PIX do recebedor>

# Google OAuth (optional)
GOOGLE_CLIENT_ID=<get from Google Cloud Console>

# Email (Resend)
RESEND_API_KEY=<get from Resend dashboard>
FROM_EMAIL=Clube Geek & Toys <contato@geeketoys.com.br>
ADMIN_EMAIL=admin@geeketoys.com.br

# URLs
FRONTEND_URL=https://club.geeketoys.com.br
API_URL=https://api.geeketoys.com.br

# CORS — additional allowed origins (comma-separated, optional)
ALLOWED_ORIGINS=https://admin.geeketoys.com.br

# Umami (change these in production!)
UMAMI_DB_PASSWORD=<generate_random_password>
UMAMI_APP_SECRET=<generate_random_string>

# ─── Backups ────────────────────────────────────────────────────────────────
# Cifra os dumps do Postgres (AES-256). Sem ela o backup RECUSA rodar em vez de
# gravar CPF, endereço e hash de senha em claro. Guarde uma cópia FORA do
# servidor: sem a senha os arquivos são ilegíveis.
BACKUP_PASSPHRASE=<generate_random_string>

# Cópia off-site num bucket S3-compatível (Cloudflare R2, Backblaze B2).
# Vazio = pula, sem derrubar o backup. Preenchido pela metade = falha avisando
# qual variável falta. Os arquivos já saem cifrados daqui, então o provedor de
# storage não entra na fronteira de confiança.
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=
# BACKUP_OFFSITE_PROVIDER=Cloudflare   # "Other" para Backblaze B2
# BACKUP_OFFSITE_PREFIX=clube-geek-toys
# Dias que uma foto apagada continua recuperável no bucket (padrão 30)
# UPLOADS_DELETED_RETENTION_DAYS=30
# Troca o bucket por um diretório — testa o pipeline inteiro sem bucket, e
# serve para uma segunda cópia num disco montado.
# BACKUP_OFFSITE_LOCAL_DIR=
